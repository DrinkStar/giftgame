[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Interactables"
3d_physics/layer_4="Animals"
3d_physics/layer_5="Buildings"
3d_physics/layer_6="BuildingWalls"
3d_physics/layer_7="FreeObjects"
3d_physics/layer_8="Enemies"
3d_physics/layer_9="EnemyHurtbox"
3d_physics/layer_10="PlayerHurtbox"

[rendering]

renderer/rendering_method="forward_plus"
scaling_3d/mode=1
scaling_3d/scale=0.75
lights_and_shadows/directional_shadow/size=2048

